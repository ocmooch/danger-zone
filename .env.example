# Fantasy Football Pipeline — environment configuration
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to git — it's already in .gitignore.

# ============================================================
# REQUIRED — YOUR LEAGUE
# ============================================================

# Your NFL.com league ID. Find this in the URL when viewing
# your league: https://fantasy.nfl.com/league/<THIS_NUMBER>
NFL_LEAGUE_ID=

# Sleeper league id of the NEWEST season (2026: see docs/sleeper D-1).
# Earlier Sleeper seasons are found through previous_league_id. When the
# league renews for a new season, put the new id here.
SLEEPER_LEAGUE_ID=

# OPTIONAL. NFL.com is defunct (history ends 2025); only the historical
# NFL.com commands need this session cookie. Treat it like a password.
NFL_COOKIE=''

# Earliest year of history to backfill. Use the earliest year
# your league existed on NFL.com (or any year >= 1999 since
# nflverse stats go back that far).
LEAGUE_START_YEAR=2014

# ============================================================
# OPTIONAL — DATABASE
# ============================================================

# Default: SQLite file in ./data/
DATABASE_URL=sqlite:///./data/fantasy.db

# For PostgreSQL when you migrate:
# DATABASE_URL=postgresql+psycopg://username:password@host:5432/fantasy

# ============================================================
# OPTIONAL — API SERVER
# ============================================================

# The FastAPI server binds here. 127.0.0.1 means localhost-only.
# DO NOT change to 0.0.0.0 unless you understand the implications.
API_HOST=127.0.0.1
API_PORT=8000

# ============================================================
# OPTIONAL — LOGGING
# ============================================================

LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json       # 'json' (production) or 'console' (development)
LOG_DIR=./data/logs

# ============================================================
# OPTIONAL — RATE LIMITING
# ============================================================

# Seconds to wait between NFL.com requests. Be polite.
NFL_COM_DELAY_SECONDS=2.0

# Max requests per minute to the Sleeper API. Their published
# cap is 1000/min; we stay well below.
SLEEPER_REQUESTS_PER_MIN=120

# Raw Sleeper league payload archive (content-addressed, gitignored).
SLEEPER_RAW_DIR=./data/raw/sleeper

# The ~5 MB Sleeper players directory is captured at most this often.
SLEEPER_PLAYERS_REFRESH_HOURS=24

# S9: the weekly job also runs `sleeper-league update` (load + score). Off until the
# season's go-live; set to true then.
SLEEPER_AUTO_LOAD=false

# ============================================================
# OPTIONAL — CACHES
# ============================================================

NFLVERSE_CACHE_DIR=./data/nflverse_cache

# ============================================================
# OPTIONAL — TUNING
# ============================================================

# Tolerance (in points) when verifying our scoring engine output
# against NFL.com's stored totals. Real-world stat corrections
# occasionally cause small mismatches.
SCORING_VERIFY_TOLERANCE=0.1

# Set to 'true' to save raw HTML responses to data/raw_pages/.
# Useful for forensic debugging; off by default to save disk.
SAVE_RAW_HTML=false

# Positions this league can roster. nflverse returns the entire NFL
# player universe (every IDP, lineman, long-snapper); only metadata for
# these positions is ingested. Team defense ("DEF") is synthesized, not
# emitted by nflverse, but is kept here as the single source of truth.
# Comma-separated; defaults to a standard offensive + kicker league.
RELEVANT_POSITIONS=QB,RB,WR,TE,K,DEF
