data/*
!data/.gitkeep
!data/logs/
!data/backups/
!data/nflverse_cache/
data/logs/*
!data/logs/.gitkeep
data/backups/*
!data/backups/.gitkeep
data/nflverse_cache/*
!data/nflverse_cache/.gitkeep

